  geom_cob(kernels_per_cob = 40) +
  labs(x = "Yield (t/ha)", y = NULL)

components <- data.frame(
  hybrid = c("A", "B", "C"),
  grain_yield = c(10.8, 10.8, 10.8),
  kernel_weight = c(270, 320, 370),
  unpollinated_kernels = c(0, 12, 30)
)

ggplot(components, aes(grain_yield, hybrid)) +
  geom_cob(
